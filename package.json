{
  "name": "myth-makers",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "genAll": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"if (!(Test-Path 'src/openapi')) { New-Item -ItemType Directory -Path 'src/openapi' | Out-Null }; dotnet build ../API/API.csproj -c Debug /p:UseAppHost=false /p:OutDir=../_build/api/ /p:AppendTargetFrameworkToOutputPath=false; Set-Location ../API; dotnet tool restore; dotnet tool run swagger tofile --output ../web/src/openapi/openapi.json ../_build/api/API.dll v1; Set-Location ../web; npx shx rm -rf src/app/api; npx openapi-generator-cli generate -c openapi-generator.config.yaml; npx prettier --write src; npx tsc -p tsconfig.json --noEmit\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:MythMakers": "node dist/myth-makers/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "~17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "~17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/platform-server": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/ssr": "^17.3.16",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "shx": "^0.3.4",
    "express": "^4.18.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.16",
    "@angular/cli": "^17.3.16",
    "@angular/compiler-cli": "^17.3.0",
    "@openapitools/openapi-generator-cli": "^2.23.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.18.0",
    "cross-env": "^10.0.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-openapi-gen": "^0.53.0",
    "shx": "^0.4.0",
    "typescript": "~5.4.2"
  }
}
